#!/usr/bin/env bash
# plab - wrapper do host para o Protheus 2610 Lab (Linux/WSL/macOS).
# Contrato: specs/001-protheus-2610-lab/contracts/plab-cli.md
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REDE=plab
ROTULO_DONO=com.plab.owner
RELEASES=(2610 2510)

sair() { local cod=$1; shift; [ $# -gt 0 ] && echo "plab: $*" >&2; exit "$cod"; }

# Le o .env como dados (KEY=VALUE), sem executar o arquivo. So guarda as variaveis PLAB_* que o
# wrapper usa (portas e listas de releases), sem exportar: o docker compose le o .env por conta
# propria (--env-file), como no plab.ps1. Senhas, chaves e tokens nem sao lidos.
# Aceita: comentario de linha, "export ", aspas simples ou duplas (sem expansao) e comentario
# inline (" #") em valor sem aspas.
ler_env() {
  local arq="$RAIZ/.env" linha chave valor
  [ -f "$arq" ] || sair 3 "arquivo .env ausente. Copie .env.example para .env e preencha as senhas."
  while IFS= read -r linha || [ -n "$linha" ]; do
    linha=${linha%$'\r'}
    [[ $linha =~ ^[[:space:]]*(export[[:space:]]+)?(PLAB_[A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    chave=${BASH_REMATCH[2]}; valor=${BASH_REMATCH[3]}
    case "$chave" in *_PASSWORD|*_TOKEN|*_KEY|*_SECRET) continue ;; esac
    if [[ $valor =~ ^\"([^\"]*)\" ]] || [[ $valor =~ ^\'([^\']*)\' ]]; then
      valor=${BASH_REMATCH[1]}
    elif [[ $valor == \#* ]]; then
      valor=""
    else
      valor=${valor%%[[:space:]]#*}
      valor=${valor%"${valor##*[![:space:]]}"}
    fi
    printf -v "$chave" '%s' "$valor"
  done < "$arq"
}

testar_docker() { docker info --format '{{.ServerVersion}}' >/dev/null 2>&1 || sair 3 "Docker nao respondeu."; }

arquivo_compose() {
  case "$1" in
    2610) echo "$RAIZ/stacks/2610/compose.yaml" ;;
    2510) echo "$RAIZ/stacks/2510/compose.yaml" ;;
    lab)  echo "$RAIZ/lab/compose.yaml" ;;
    *) sair 2 "alvo invalido: '$1' (use 2610, 2510, lab ou all)" ;;
  esac
}

compose() { local alvo=$1; shift; docker compose --env-file "$RAIZ/.env" -f "$(arquivo_compose "$alvo")" "$@"; }

# Valida no shell principal: um 'exit' dentro de $(...) so encerraria o subshell.
validar_alvo() {
  case "${1:-}" in
    all|2610|2510|lab) ;;
    "") sair 2 "informe o alvo: 2610, 2510, lab ou all" ;;
    *) sair 2 "alvo invalido: '$1' (use 2610, 2510, lab ou all)" ;;
  esac
}

alvos() {
  case "$1" in
    all) echo "${RELEASES[*]} lab" ;;
    *) echo "$1" ;;
  esac
}

# A rede e criada com o label com.plab.owner=plab e uma rede "plab" sem ele nao e reutilizada
# (Principio IV). Excecao: rede de versao anterior do plab (sem label) em que todos os containers
# ligados sao dos projetos plab-*; segue com aviso para recriar quando puder.
garantir_rede() {
  if ! docker network inspect "$REDE" >/dev/null 2>&1; then
    docker network create --label "$ROTULO_DONO=plab" "$REDE" >/dev/null || sair 3 "falha ao criar a rede $REDE"
    echo "rede $REDE criada"; return 0
  fi
  if [ "$(docker network inspect "$REDE" --format "{{index .Labels \"$ROTULO_DONO\"}}" 2>/dev/null)" = plab ]; then
    echo "rede $REDE ja existe"; return 0
  fi
  local projetos
  projetos=$(docker ps -a --filter "network=$REDE" --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u)
  if [ -n "$projetos" ] && ! grep -qvxE 'plab-(2610|2510|lab)' <<<"$projetos"; then
    echo "plab: aviso: a rede $REDE nao tem o label $ROTULO_DONO=plab (criada por versao anterior do plab)." \
         "Para recriar: ./plab down all && docker network rm $REDE && ./plab net" >&2
    return 0
  fi
  sair 3 "ja existe uma rede '$REDE' sem o label $ROTULO_DONO=plab, que o plab nao reutiliza." \
         "Se for de outro projeto, renomeie a dele; se for de uma versao anterior do lab: docker network rm $REDE"
}

projeto_rodando() { [ -n "$(docker ps -q --filter "label=com.docker.compose.project=plab-$1")" ]; }

portas_do_alvo() { compgen -v | grep "^PLAB_${1}_PORT_" | sort || true; }

porta_em_uso() {
  if command -v ss >/dev/null 2>&1; then ss -ltn "sport = :$1" | tail -n +2 | grep -q .
  elif command -v lsof >/dev/null 2>&1; then lsof -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  else (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; fi
}

cmd_ports() {
  for alvo in "${RELEASES[@]}"; do
    for var in $(portas_do_alvo "$alvo"); do
      local p=${!var} estado=livre
      if porta_em_uso "$p"; then
        if projeto_rodando "$alvo"; then estado="em uso (provavelmente plab-$alvo)"; else estado="OCUPADA"; fi
      fi
      printf '%-24s %6s  %s\n' "$var" "$p" "$estado"
    done
  done
}

checar_portas() {
  local alvo=$1 ocupadas=""
  [ "$alvo" = lab ] && return 0
  projeto_rodando "$alvo" && return 0
  for var in $(portas_do_alvo "$alvo"); do
    porta_em_uso "${!var}" && ocupadas+=$'\n'"  $var=${!var} ocupada"
  done
  [ -z "$ocupadas" ] || sair 4 "portas ocupadas; ajuste no .env:$ocupadas"
}

# Evita a troca obrigatoria de senha do Admin quando a base da imagem passa do prazo da
# politica (caso da 2510). Nao altera a senha; so a data da ultima troca. Decisao registrada em
# STATUS.md e plan.md (Complexity Tracking). Releases em PLAB_RENOVAR_SENHA_ADMIN (padrao 2510).
# A senha do banco e lida dentro do container (POSTGRES_PASSWORD da imagem): nada em argv nem em
# arquivo temporario; o SQL vai pela entrada padrao.
renovar_senha_admin() {
  local alvo=$1
  [[ " ${PLAB_RENOVAR_SENHA_ADMIN-2510} " == *" $alvo "* ]] || return 0
  # shellcheck disable=SC2016 # expandido dentro do container, de proposito
  if compose "$alvo" exec -T db sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" exec psql -h 127.0.0.1 -U postgres -d protheus -q -A -t -v ON_ERROR_STOP=1' \
       < "$RAIZ/stacks/sql/renova-senha-admin.sql" >/dev/null 2>&1; then
    echo "senha do Admin renovada (sem alteracao) em plab-$alvo"
  else
    echo "plab: aviso: renovacao da senha do Admin falhou em plab-$alvo" >&2
  fi
}

cmd_up() {
  validar_alvo "${1:-}"; testar_docker; garantir_rede
  for alvo in $(alvos "$1"); do
    checar_portas "$alvo"
    # No Docker Engine Linux um bind inexistente nasce root:root e o usuario lab (uid 1000) nao grava.
    [ "$alvo" = lab ] && mkdir -p "$RAIZ/workspace" "$RAIZ/evidencias"
    echo "subindo plab-$alvo..."
    compose "$alvo" up -d --wait --wait-timeout 900 || sair 5 "plab-$alvo nao ficou healthy. Veja: ./plab logs $alvo"
    [ "$alvo" = lab ] || renovar_senha_admin "$alvo"
  done
  cmd_status "${1:-}"
}

cmd_down() {
  local alvo_arg=$1 volumes=${2:-}
  validar_alvo "$alvo_arg"
  case "$volumes" in ""|--volumes) ;; *) sair 2 "opcao invalida: '$volumes' (use --volumes)" ;; esac
  testar_docker
  for alvo in $(alvos "$alvo_arg"); do
    local args=(down)
    if [ "$volumes" = "--volumes" ]; then
      # Sem terminal (stdin fechado) o read falha: vale como "nao confirmado", sem abortar o set -e.
      local conf=""
      read -r -p "Isto APAGA os dados de plab-$alvo. Digite '$alvo' para confirmar: " conf || conf=""
      [ "$conf" = "$alvo" ] || { echo "cancelado para $alvo"; continue; }
      args+=(--volumes)
    fi
    compose "$alvo" "${args[@]}" || sair 5 "falha no down de plab-$alvo"
  done
}

cmd_status() {
  testar_docker
  local lista
  if [ -n "${1:-}" ]; then validar_alvo "$1"; lista=$(alvos "$1"); else lista="${RELEASES[*]} lab"; fi
  for alvo in $lista; do
    echo "== plab-$alvo"
    compose "$alvo" ps --format 'table {{.Service}}\t{{.State}}\t{{.Health}}\t{{.Ports}}' || true
    if [ "$alvo" != lab ]; then
      # WebApp pela porta multiprotocolo: no 26.x o /app-root (login PO UI) so existe nela.
      local tcp="PLAB_${alvo}_PORT_TCP" rest="PLAB_${alvo}_PORT_REST"
      echo "   WebApp:  http://127.0.0.1:${!tcp}/webapp/"
      echo "   TCP/TDS: 127.0.0.1:${!tcp}   REST: http://127.0.0.1:${!rest}/rest/"
    fi
  done
}

cmd_lab() {
  testar_docker
  projeto_rodando lab || sair 3 "container lab parado. Rode: ./plab up lab"
  # -T (sem TTY) quando nao ha terminal; o setup interativo precisa de TTY.
  local tty=(-T); [ -t 0 ] && [ "${1:-}" = setup ] && tty=()
  docker compose --env-file "$RAIZ/.env" -f "$(arquivo_compose lab)" exec "${tty[@]}" lab lab "$@"
}

esperar_healthy() { # alvo servico segundos
  local id fim
  id=$(compose "$1" ps -q "$2"); fim=$((SECONDS + ${3:-600}))
  while [ $SECONDS -lt $fim ]; do
    [ "$(docker inspect "$id" --format '{{.State.Health.Status}}' 2>/dev/null)" = healthy ] && return 0
    sleep 5
  done
  return 1
}

# Reinicia so o AppServer da release. Na 2510 e o jeito de trazer de volta o /app-root depois de uma
# compilacao (o AppServer 24.3 religa o REST na porta do servidor interno da interface nova).
# Retorna o codigo (nao sai) para o smoke poder reportar o passo 5.
reiniciar_appserver() {
  echo "reiniciando o appserver de plab-$1..."
  compose "$1" restart appserver || { echo "plab: falha ao reiniciar o appserver de plab-$1" >&2; return 5; }
  sleep 20
  esperar_healthy "$1" appserver 600 || { echo "plab: appserver de plab-$1 nao ficou healthy" >&2; return 5; }
  cmd_lab doctor "$1" || return 5
}

cmd_restart() {
  case "${1:-}" in 2610|2510) ;; *) sair 2 "use: restart 2610|2510" ;; esac
  testar_docker
  reiniciar_appserver "$1" || exit $?
}

cmd_smoke() {
  case "${1:-}" in 2610|2510) ;; *) sair 2 "use: smoke 2610|2510" ;; esac
  cmd_lab smoke "$1" || exit $?
  if [[ " ${PLAB_REINICIAR_APOS_COMPILAR:-2510} " == *" $1 "* ]]; then
    echo "[5/5] recuperacao      reiniciando appserver $1 (compilacao derruba o /app-root nesta release)"
    reiniciar_appserver "$1" || { echo "FALHOU $1 no passo 5/recuperacao"; exit 15; }
    echo "[5/5] recuperacao      OK   (interface nova de volta apos a compilacao)"
  fi
}

ajuda() {
  cat <<'EOF'
plab - Protheus 2610 Lab
  ./plab net                       cria a rede "plab" (idempotente)
  ./plab ports                     portas configuradas e se estao livres
  ./plab up <2610|2510|lab|all>    sobe e aguarda healthy
  ./plab down <alvo> [--volumes]   derruba (com --volumes apaga dados, pede confirmacao)
  ./plab status [alvo]             estado e URLs
  ./plab logs <alvo> [servico]
  ./plab smoke <2610|2510>         smoke dentro do container lab
  ./plab restart <2610|2510>       reinicia o AppServer e roda o doctor
  ./plab setup                     assistente "lab setup"
  ./plab scan                      varredura de segredos
EOF
}

cmd=${1:-help}; shift || true
case "$cmd" in
  net)    testar_docker; garantir_rede ;;
  ports)  ler_env; cmd_ports ;;
  up)     ler_env; cmd_up "${1:-}" ;;
  down)   ler_env; cmd_down "${1:-}" "${2:-}" ;;
  status) ler_env; cmd_status "${1:-}" ;;
  logs)   ler_env
          case "${1:-}" in 2610|2510|lab) ;; *) sair 2 "use: logs 2610|2510|lab [servico]" ;; esac
          testar_docker; compose "$1" logs --tail 200 ${2:+"$2"} ;;
  smoke)  ler_env; cmd_smoke "${1:-}" ;;
  restart) ler_env; cmd_restart "${1:-}" ;;
  setup)  ler_env; cmd_lab setup ;;
  scan)   exec bash "$RAIZ/lab/bin/plab-scan" ;;
  help|-h|--help) ajuda ;;
  *) ajuda; exit 2 ;;
esac
