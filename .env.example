# Protheus 2610 Lab - configuracao de exemplo (versionada, SEM segredos).
# Copie para .env e preencha somente as variaveis *_PASSWORD (o .env nao vai para o git).
# Senhas com $: use aspas simples E escreva cada $ como $$ (regra do Docker Compose).
#   Exemplo: a senha  a$b$  fica  PLAB_X_ADMIN_PASSWORD='a$$b$$'
# Confira dentro do lab: docker compose -f lab/compose.yaml exec lab wc -c /run/secrets/<nome>

# ---------------------------------------------------------------------------
# Imagens 12.1.2610 (fonte principal: comunidade emebatista, publicada em 17/10/2026)
# Digests verificados em 2026-11-02.
# ---------------------------------------------------------------------------
PLAB_2610_IMG_DB=emebatista/postgres-2610:1.0.0@sha256:fca7d2bea756f9e8c6e48788d5bde8705bdc31875a36da70190f449eada7cdb8
PLAB_2610_IMG_LICENSE=emebatista/license-server-2610:1.0.0@sha256:a5d35ee1847d422f9885486e8d83d36757964baeb71d4c77104a669661bf2c83
PLAB_2610_IMG_DBACCESS=emebatista/protheus-dbaccess-2610:1.0.0@sha256:efa60f4557466ae67c494c9f0a8e287b16cc7c266f80f2cb9e3b8c715c75d44d
PLAB_2610_IMG_APPSERVER=emebatista/protheus-2610:1.0.0@sha256:b8ab6047dbc3dff489fceede51c6db403d648f16e63cbb74290167391204c7c0

# ---------------------------------------------------------------------------
# Imagens 12.1.2510 (fonte principal: comunidade emebatista, publicada em 12/10/2025)
# ---------------------------------------------------------------------------
PLAB_2510_IMG_DB=emebatista/postgres-2510:1.0.0@sha256:d0c7acadf9fc41a07ca349f6d1d43c0d1152eb7db1258c3901c8519e09a51730
PLAB_2510_IMG_LICENSE=emebatista/license-server-2510:1.0.0@sha256:e8f9025676666e3640fa45ecfe07efd16873c80149364eba7bdd4a96f7588571
PLAB_2510_IMG_DBACCESS=emebatista/protheus-dbaccess-2510:1.0.0@sha256:5e47bf6372697689bd714d81ed9969e00ea60e852fe970500bd0b991fd3ecd11
PLAB_2510_IMG_APPSERVER=emebatista/protheus-2510:1.0.0@sha256:e5079060a554f6a6e84f77afbc8bf02e2bed4e5093fe3bc181833fd0cd5d8a3d

# ---------------------------------------------------------------------------
# Fonte reserva (comunidade feliperaposo, publicada em 22/10/2026; digests verificados em
# 2026-11-05). Use se as imagens principais sumirem: PLAB_<rel>_FONTE=reserva e ./plab up <rel>.
# Mesmos comandos, portas e nomes; volumes proprios (-reserva). A base vem VAZIA e o plab a prepara
# (plab inicializar: empresa TESTE 99/01, Admin importado da base principal local, dicionario e
# primeiro acesso). Detalhes e diferencas: README > Fonte reserva.
# A oficial TOTVS (totvsengpro/*) nao serve como reserva: o AppServer dela exige RPO e dicionario
# fornecidos por voce (arquivos licenciados que o lab nao redistribui).
# ---------------------------------------------------------------------------
PLAB_2610_FONTE=principal
PLAB_2510_FONTE=principal
PLAB_2610_RES_IMG_DB=feliperaposo/protheus-postgresql:18@sha256:ee1dae0868925db322d97e80c5033876432331d2a4e0aceab9f7798a44791353
PLAB_2610_RES_IMG_LICENSE=feliperaposo/protheus-license:3.7.2@sha256:a502e37988654034008e39da0ca5bf5b0fc3fe9853c737f2929c730e2f91b6b0
PLAB_2610_RES_IMG_DBACCESS=feliperaposo/protheus-dbaccess:26.1.0.1@sha256:6edfe6e09dafdfe717648a52830ccd5236a81900599486e3c75e7338407d1023
PLAB_2610_RES_IMG_APPSERVER=feliperaposo/protheus:p12.1.2610@sha256:0571f813ef35a0eca9e95a6a3f4c6b3b008a2eb12e379d61768afb9559c9b0fe
PLAB_2510_RES_IMG_DB=feliperaposo/protheus-postgresql:16@sha256:3b81f8d080b4a16b1bae1a1bc09bb5ac0eaab3ae98254fe6a8e4b9aa08aba6bf
PLAB_2510_RES_IMG_LICENSE=feliperaposo/protheus-license:3.7.2@sha256:a502e37988654034008e39da0ca5bf5b0fc3fe9853c737f2929c730e2f91b6b0
PLAB_2510_RES_IMG_DBACCESS=feliperaposo/protheus-dbaccess:24.1.1.3@sha256:76a3ea7ee8771987ae8931f936de6871ad3bb69e1adf6174dc98ea932d84801d
PLAB_2510_RES_IMG_APPSERVER=feliperaposo/protheus:p12.1.2510@sha256:99815a8eccc9040531506cb43a8116409a4ffe73a1e1d0db38ce64ab0c5b912b
# HAProxy oficial da porta 1234 das reservas (stacks/reserva/haproxy-approot.cfg).
PLAB_RES_IMG_HAPROXY=haproxy:3.0.30-alpine@sha256:1c15903c50d5510dcc01de755049e7015a6dd3f35bb2dc4582e888116cb71d8f
# Senhas do Postgres da reserva (superusuario e usuario protheus), definidas por voce. So sao
# exigidas quando alguma release usa a reserva.
PLAB_RES_DB_ROOT_PASSWORD=
PLAB_RES_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Portas no host (sempre em 127.0.0.1). Troque aqui se alguma estiver ocupada.
# ---------------------------------------------------------------------------
PLAB_2610_PORT_TCP=26234
PLAB_2610_PORT_WEBAPP=26321
PLAB_2610_PORT_REST=26181
PLAB_2610_PORT_DB=26432
PLAB_2610_PORT_LICMON=26020

PLAB_2510_PORT_TCP=25234
PLAB_2510_PORT_WEBAPP=25321
PLAB_2510_PORT_REST=25181
PLAB_2510_PORT_DB=25432
PLAB_2510_PORT_LICMON=25020

# ---------------------------------------------------------------------------
# Ambientes Protheus (confirmados no appserver.ini das imagens)
# ---------------------------------------------------------------------------
PLAB_2610_ENV=P2610
PLAB_2610_ENV_COMPILA=P2610_COMPILA
PLAB_2510_ENV=P2510
PLAB_2510_ENV_COMPILA=P2510D

# Usuario administrador do ambiente padrao. A senha padrao de cada release e publica
# (README da fonte da imagem); informe-a apenas no seu .env local.
PLAB_ADMIN_USER=Admin
PLAB_2610_ADMIN_PASSWORD=
PLAB_2510_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Limites de memoria por servico (ajuste conforme a maquina)
# ---------------------------------------------------------------------------
PLAB_MEM_DB=2g
PLAB_MEM_LICENSE=1g
PLAB_MEM_DBACCESS=1g
PLAB_MEM_APPSERVER=6g
PLAB_MEM_LAB=4g

# Politica de reinicio dos containers de longa duracao (db, license, dbaccess, appserver e lab).
# "unless-stopped" (padrao) faz as stacks voltarem sozinhas quando o Docker inicia; use "no" para
# so subirem com "plab up" e nao ocuparem RAM em maquinas com outros ambientes.
PLAB_RESTART=unless-stopped

# Releases cujo AppServer derruba a interface nova (/app-root) ao compilar e precisam de reinicio
# depois (verificado em 02/11/2026 no AppServer 24.3.1.1 da 2510). "plab smoke" faz o reinicio.
PLAB_REINICIAR_APOS_COMPILAR=2510

# Releases em que "plab up" renova a data da ultima troca de senha do Admin (a base da imagem
# 2510 passou do prazo da politica e o login pediria troca obrigatoria). Nao altera a senha.
# Deixe vazio para nao mexer na base.
PLAB_RENOVAR_SENHA_ADMIN=2510

# Modo desenvolvimento do container lab: 1 monta lab/, cenarios/ e skills/ do repositorio em
# /opt/plab (somente leitura) via lab/compose.dev.yaml; correcoes valem sem rebuild da imagem.
# 0 ou vazio (padrao): usa o codigo copiado na imagem. Mudou? Rode "plab up lab" de novo.
PLAB_LAB_DEV=0

# ---------------------------------------------------------------------------
# Imagem lab (versoes fixadas, verificadas em 2026-11-02)
# ---------------------------------------------------------------------------
PLAB_UBUNTU=24.04
PLAB_NODE=22.23.4
PLAB_TIR=2.14.12
# Playwright (Python) complementa o TIR em diagnostico e telas web novas; usa o Chrome acima.
PLAB_PLAYWRIGHT=1.64.1
PLAB_CHROME=156.0.8078.80
# SHA-256 dos zips linux64 dessa versao (o build confere com sha256sum -c).
PLAB_CHROME_SHA256=b711c720f774be355197f32edf37e0651418ba036d92446ee2da19ac017540a7
PLAB_CHROMEDRIVER_SHA256=cae58bbd262ba5c8a0ce2540f44254b6e789efc4fe9b18bbb4a00487a9f5859e
PLAB_TDS_LS=2.2.7

# CLIs de IA (instaladas pelo "lab setup" no volume lab-home)
PLAB_CLAUDE_CODE=2.1.316
PLAB_CODEX=0.166.0
PLAB_OPENCODE=1.19.5
PLAB_GEMINI_CLI=0.66.0

# Skills de terceiros clonadas no setup (commit fixado)
PLAB_ENGPRO_COMMIT=41504805e419b72232885f7575d54dfd573fea1b
PLAB_EXEMPLOS_COMMIT=
